# TruthLens Environment Variables (Placeholders Only - Never Commit .env)

# --- Google Gemini API (Required for Media Literacy Assistant Chatbot) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Django Backend Configuration ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional: Guardian Open Platform API (For Live News Monitoring) ---
GUARDIAN_API_KEY=

# --- React Frontend Configuration ---
REACT_APP_API_BASE_URL=http://127.0.0.1:8000
